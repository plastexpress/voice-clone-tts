# =============================================================================
# voice-clone-tts — configuração central
# Copie para deploy/.env (o start.sh faz isso automaticamente) e ajuste.
# =============================================================================

# -----------------------------------------------------------------------------
# Portas expostas no host
# -----------------------------------------------------------------------------
FRONTEND_PORT=8095          # interface web (login user/senha)
API_PORT=8096               # API pública de geração de áudio (token no header)
PB_PORT=8090                # PocketBase — admin UI em http://localhost:8090/_/

# -----------------------------------------------------------------------------
# PocketBase (banco de dados / usuários)
# -----------------------------------------------------------------------------
# Superusuário do PocketBase (admin UI + usado pelo backend para ler tokens)
PB_ADMIN_EMAIL=admin@voiceclone.local
PB_ADMIN_PASSWORD=troque-esta-senha-por-favor

# Primeiro usuário da INTERFACE (criado no primeiro boot, coleção `users`)
PB_INITIAL_USER_EMAIL=admin@voiceclone.local
PB_INITIAL_USER_PASSWORD=troque-esta-senha-tambem
PB_INITIAL_USER_NAME=Admin

# -----------------------------------------------------------------------------
# Engine de TTS
# -----------------------------------------------------------------------------
# moss  = MOSS-TTS Local rodando na GPU (produção)
# dummy = gerador sintético sem GPU/modelo (útil para testar a stack e a UI)
TTS_ENGINE=moss

# Modelo. Alternativas:
#   OpenMOSS-Team/MOSS-TTS-Local-Transformer-v1.5  -> 5B, 48kHz estéreo, 31 idiomas (~10GB VRAM)
#   OpenMOSS-Team/MOSS-TTS-Local-Transformer       -> 1.7B, 24kHz mono   (~5GB VRAM, mais rápido)
MOSS_MODEL_ID=OpenMOSS-Team/MOSS-TTS-Local-Transformer-v1.5

# Fixa o commit do repositório do modelo no Hugging Face (recomendado em produção).
# O MOSS roda com trust_remote_code, ou seja, EXECUTA código Python vindo do repo.
# Sem revisão fixa, uma atualização do repositório passa a rodar código novo aqui.
# Pegue o hash em: https://huggingface.co/OpenMOSS-Team/MOSS-TTS-Local-Transformer-v1.5/commits/main
MOSS_MODEL_REVISION=

MOSS_DEVICE=cuda

# Onde roda o audio tokenizer (codifica a referência do clone e decodifica a fala).
# Ele sozinho ocupa ~4GB de VRAM. Numa RTX 3060 de 12GB isso NÃO sobra depois do
# modelo de 5B (~8,5GB) — a carga estoura a placa. Por isso:
#   auto  -> CPU em GPUs com menos de 16GB, GPU nas maiores  (recomendado)
#   cpu   -> sempre na CPU: libera ~4GB, custa alguns segundos por geração
#   cuda  -> sempre na GPU: só com 16GB+ de VRAM
MOSS_TOKENIZER_DEVICE=auto

MOSS_DTYPE=bfloat16
# auto | flash_attention_2 | sdpa | eager
MOSS_ATTN_IMPLEMENTATION=auto
# Carrega o modelo já no boot do container (senão carrega no 1º request)
MOSS_PRELOAD=true
# Teto de tokens de áudio gerados (1 segundo de fala ≈ 12.5 tokens)
MOSS_MAX_NEW_TOKENS=4096

# Parâmetros de amostragem padrão (recomendados para o Local-Transformer-v1.5)
TTS_TEMPERATURE=1.7
TTS_TOP_P=0.8
TTS_TOP_K=25
TTS_REPETITION_PENALTY=1.0
# Idioma padrão quando o token não define (ex.: Portuguese, English, Spanish)
TTS_DEFAULT_LANGUAGE=Portuguese
# Limite de caracteres por request
TTS_MAX_TEXT_LENGTH=5000

# -----------------------------------------------------------------------------
# Saída de áudio (Opus)
# -----------------------------------------------------------------------------
OPUS_BITRATE=64k
OPUS_CHANNELS=1             # 1 = mono (recomendado para voz), 2 = estéreo
OPUS_SAMPLE_RATE=48000
OPUS_APPLICATION=audio      # audio | voip | lowdelay

# -----------------------------------------------------------------------------
# Cache local de áudios gerados
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
# Quando o cache passar disso, os itens menos usados são removidos (0 = sem limite)
CACHE_MAX_GB=20

# -----------------------------------------------------------------------------
# Fila / concorrência (a GPU processa 1 request por vez)
# -----------------------------------------------------------------------------
QUEUE_MAX_SIZE=64
# Tempo máximo que um request síncrono espera na fila + geração (segundos)
SYNC_TIMEOUT_SECONDS=300
# Retenção de jobs assíncronos concluídos (horas)
JOB_RETENTION_HOURS=48

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
REQUEST_LOG_ENABLED=true
LOG_LEVEL=INFO

# Chave que permite "revelar" o valor de um token da API depois de criado
# (fica guardado cifrado, além do hash usado pra autenticar). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Vazio = a autenticação continua normal, só a função de revelar fica desligada.
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
# URL pública da API — usada nos exemplos de código da interface e também
# pelo próprio backend para montar o link de download nos callbacks de
# /v1/tts/async (campo callback_url). Ajuste para o seu domínio.
PUBLIC_API_URL=https://voice-api.plastexpress.com.br

# Origem(s) permitida(s) para CORS no backend. Separe múltiplos domínios por vírgula.
# Exemplo: https://voice.plastexpress.com.br,https://voice-server.plastexpress.com.br,https://voice-api.plastexpress.com.br
CORS_ORIGINS=https://voice.plastexpress.com.br,https://voice-server.plastexpress.com.br,https://voice-api.plastexpress.com.br


# -----------------------------------------------------------------------------
# GPU
# -----------------------------------------------------------------------------
# Índice da GPU a usar (0 = primeira). "all" para todas.
NVIDIA_VISIBLE_DEVICES=0
# Ajuda a evitar fragmentação de VRAM em placas de 12GB
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
